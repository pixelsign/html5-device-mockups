{
  "name": "html5-device-mockups",
  "version": "4.0.0",
  "description": "HTML5 mockups of popular devices, to showcase your portfolio and spice up your website.",
  "main": "dist/device-mockups.min.css",
  "style": "dist/device-mockups.css",
  "scripts": {
    "build": "npm run build:css && npm run build:min",
    "build:css": "sass --no-source-map src/scss/device-mockups.scss dist/device-mockups.css",
    "build:min": "sass --no-source-map --style=compressed src/scss/device-mockups.scss dist/device-mockups.min.css",
    "watch": "sass --no-source-map --watch src/scss/device-mockups.scss dist/device-mockups.css"
  },
  "author": "",
  "license": "MIT",
  "homepage": "https://pixelsign.github.io/html5-device-mockups",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelsign/html5-device-mockups.git"
  },
  "devDependencies": {
    "sass": "1.105.1"
  }
}
